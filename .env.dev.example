# =============================================================================
# AMS Platform — ambiente DEV (desarrollo en VPS)
# =============================================================================
# Copiar a .env.dev en el VPS y completar.
# Subdominio sugerido: dev.amsplatform.tudominio
# Puerto host: 6700

NODE_ENV=production
PORT=3000

# Backend agent (servicio Docker en la misma red)
NEXT_PUBLIC_AGENT_API_URL=https://dev-api.amsplatform.tudominio
# Si los servicios están en la misma red Docker:
# NEXT_PUBLIC_AGENT_API_URL=http://supply-chain-ams-backend-dev:8000

# Mock LLM (útil para demos sin credenciales)
# NEXT_PUBLIC_FORCE_MOCK_LLM=1

# Telemetria (opcional)
# NEXT_PUBLIC_SENTRY_DSN=
