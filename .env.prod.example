# =============================================================================
# AMS Platform — ambiente PROD (v1.1.3 audit-ready)
# =============================================================================
# Subdominio: amsplatform.tudominio
# Puerto host: 6900
#
# Vars NEXT_PUBLIC_* van al bundle JS — visibles al cliente. NO secrets.
# =============================================================================

NODE_ENV=production
PORT=3000

# Backend API URL (visible al browser para fetchs cross-origin)
NEXT_PUBLIC_AGENT_API_URL=https://api.amsplatform.tudominio

# =============================================================================
# Branding / contacto comercial — usado en landing pública /marketing
# =============================================================================
NEXT_PUBLIC_SALES_EMAIL=ventas@tudominio.cl
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tudominio.cl
NEXT_PUBLIC_COMPANY_NAME=Tu Empresa SpA

# =============================================================================
# Telemetría — Sentry frontend
# =============================================================================
# REQUERIDO en PROD si querés captura de errores client-side.
# Setup: https://sentry.io → New Project → React/Next.js → copiar DSN.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=production
NEXT_PUBLIC_SENTRY_TRACES_RATE=0.1

# =============================================================================
# Otros
# =============================================================================
# Mock OFF en PROD (no forzar respuestas LLM mock)
# NEXT_PUBLIC_FORCE_MOCK_LLM=
