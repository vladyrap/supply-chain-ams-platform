{
  "name": "ams-manual-capture",
  "version": "0.2.0",
  "private": true,
  "description": "Scripts Playwright para capturas + PDFs del manual AMS Platform",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "capture:tickets": "tsx capture-tickets.ts",
    "capture:all": "tsx capture-all.ts",
    "pdf:all": "tsx generate-pdfs.ts",
    "build": "npm run capture:all && npm run pdf:all",
    "clean:screens": "rimraf ../screens",
    "clean:pdfs": "rimraf ../pdf"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "playwright": "^1.45.0",
    "tsx": "^4.15.0",
    "rimraf": "^5.0.5",
    "marked": "^12.0.0",
    "highlight.js": "^11.10.0"
  }
}
